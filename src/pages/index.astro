---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import MotorExplorer from "../components/MotorExplorer.tsx";
import RepairGuide from "../components/RepairGuide.astro";
import { Button } from "../components/ui/button.tsx";

const whatsappUrl = "https://wa.me/21620535769";
---

<Layout
  title="MotorFix — réparation de moteurs électriques"
  description="MotorFix répare les moteurs électriques : appareils ménagers, scooters, trottinettes et véhicules électriques. Activité en cours de développement. Contact WhatsApp pour envoyer des photos et obtenir une estimation."
>
  <div class="sticky top-0 z-50">
    <p class="bg-banner py-2 text-center text-sm font-semibold text-banner-foreground" style="padding-inline: 1cm" data-i18n="banner">
      Site en cours de construction — ouverture progressive de l’atelier.
    </p>
    <SiteHeader />
  </div>

  <main id="contenu">
    <section id="accueil" class="scroll-mt-36">
      <div class="grid w-full gap-10 py-14 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:py-20" style="padding-inline: 1cm">
        <div>
          <p class="text-sm font-semibold tracking-[0.16em] text-primary uppercase dark:text-primary-foreground" data-i18n="hero.kicker">Atelier de moteurs électriques</p>
          <h1 class="mt-3 font-display text-5xl leading-[1.05] font-semibold tracking-tight sm:text-6xl" data-i18n="hero.title">
            MotorFix remet les moteurs en mouvement.
          </h1>
          <div class="mt-4 h-px w-24 bg-copper" aria-hidden="true"></div>
          <p class="mt-5 text-lg leading-8 text-muted-foreground" data-i18n="hero.lead">
            L'activité est en cours de développement. Le site présente déjà les familles de moteurs que l’atelier couvre, de la maison jusqu’au véhicule électrique.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button asChild size="lg" className="rounded-full px-5">
              <a href="#moteurs" data-i18n="hero.browse">Parcourir les moteurs</a>
            </Button>
            <Button asChild variant="outline" size="lg" className="rounded-full px-5">
              <a href="#contact" data-i18n="hero.photos">Envoyer des photos</a>
            </Button>
          </div>
        </div>

        <div class="relative overflow-hidden rounded-[2rem] border border-aluminum bg-primary p-8 text-primary-foreground shadow-[0_24px_60px_-36px_rgba(11,31,51,0.8)] dark:bg-card dark:text-foreground">
          <div class="absolute -top-16 -right-10 h-48 w-48 rounded-full bg-accent/25 blur-2xl" aria-hidden="true"></div>
          <svg viewBox="0 0 200 200" class="relative mx-auto h-44 w-44" aria-hidden="true">
            <circle cx="100" cy="100" r="78" fill="none" class="text-aluminum" stroke="currentColor" stroke-width="2" />
            <circle cx="100" cy="100" r="52" fill="none" class="text-aluminum-deep" stroke="currentColor" stroke-width="6" stroke-dasharray="8 10" />
            <circle cx="100" cy="100" r="28" fill="none" class="text-copper" stroke="currentColor" stroke-width="2" />
            <circle cx="100" cy="100" r="5" class="text-copper" fill="currentColor" />
            <path d="M100 8v24M100 168v24M8 100h24M168 100h24" class="text-aluminum-deep" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
          </svg>
          <p class="relative mt-6 font-display text-2xl font-semibold" data-i18n="hero.cardTitle">Quatre familles, un même geste</p>
          <p class="relative mt-2 text-sm leading-6 text-primary-foreground/80 dark:text-foreground/80" data-i18n="hero.cardText">
            Appareils ménagers, scooters électriques, trottinettes et véhicules électriques.
          </p>
        </div>
      </div>
    </section>

    <div class="w-full pb-16" style="padding-inline: 1cm">
      <MotorExplorer client:load />

      <RepairGuide />

      <section id="maintenance" class="scroll-mt-36 mt-16 rounded-[1.8rem] border border-aluminum bg-muted p-6 sm:p-8">
        <p class="text-sm font-semibold tracking-[0.16em] text-primary uppercase dark:text-primary-foreground" data-i18n="maintenance.kicker">Maintenance</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight" data-i18n="maintenance.heading">Un relais, le temps de l’ouverture</h2>
        <p class="mt-4 text-base leading-7" data-i18n="maintenance.text">
          Nous disposons déjà de certains contacts pour assurer la maintenance, contre une commission. Le suivi se précise avec les photos du moteur, avant d’organiser la suite.
        </p>
      </section>

      <section id="paiement" class="scroll-mt-36 mt-8 rounded-[1.8rem] border border-dashed border-aluminum bg-card p-6 sm:p-8">
        <p class="text-sm font-semibold tracking-[0.16em] text-primary uppercase dark:text-primary-foreground" data-i18n="payment.kicker">Paiement</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight" data-i18n="payment.heading">Bientôt disponible</h2>
        <p class="mt-4 leading-7 text-muted-foreground" data-i18n="payment.text">
          Le moyen de paiement sera choisi plus tard. Aucun règlement n’est possible sur ce site pour le moment : cette section reste un emplacement, le temps de trancher.
        </p>
      </section>

      <section id="contact" class="scroll-mt-36 mt-8 overflow-hidden rounded-[1.8rem] bg-primary text-primary-foreground dark:bg-card dark:text-foreground">
        <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold tracking-[0.16em] text-primary-foreground/80 uppercase dark:text-foreground/80" data-i18n="contact.kicker">WhatsApp</p>
            <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight sm:text-4xl" data-i18n="contact.heading">
              Envoyez vos photos sur WhatsApp : nous estimons avant tout appel.
            </h2>
            <p class="mt-4 text-sm leading-7 text-primary-foreground/80 dark:text-foreground/80" data-i18n="contact.lead">
              Photographiez le moteur, la plaque et le problème. MotorFix prépare une estimation à partir de ces images, avant d’appeler — ensuite, c’est plus compliqué.
            </p>
            <p class="mt-4 text-sm font-semibold tracking-wide text-primary-foreground dark:text-foreground">
              +216 20 535 769
            </p>
          </div>
          <div class="rounded-[1.4rem] border border-aluminum bg-card p-5 text-foreground">
            <p class="text-sm leading-6 text-muted-foreground" data-i18n="contact.note">
              Un seul bouton, le temps d’ajouter le vrai numéro WhatsApp.
            </p>
            <Button asChild className="mt-4 h-auto w-full rounded-full bg-whatsapp px-5 py-3 text-sm font-semibold text-whatsapp-foreground shadow-sm hover:bg-whatsapp/90">
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
                <span aria-hidden="true">●</span>
                <span data-i18n="contact.button">Envoyer mes photos sur WhatsApp</span>
              </a>
            </Button>
            <p class="mt-4 text-sm leading-6 text-foreground" data-i18n="contact.disclaimer">
              Le support ne concerne pas tous les moteurs. Envoyez d'abord des photos pour que nous puissions l'étudier, avant tout engagement.
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="border-t border-aluminum py-8 text-center text-sm text-muted-foreground" style="padding-inline: 1cm">
    <p class="font-display text-lg text-foreground">MotorFix</p>
    <p class="mt-1" data-i18n="footer.line">Réparation de moteurs électriques · en cours de construction</p>
  </footer>
</Layout>
