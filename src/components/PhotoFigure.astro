---
interface Props {
  file: string;
  altKey: string;
  alt: string;
  folder?: "stock" | "original";
}

const { file, altKey, alt, folder = "stock" } = Astro.props;
const src =
  folder === "original"
    ? `${import.meta.env.BASE_URL}images/${file}`
    : `${import.meta.env.BASE_URL}images/stock/${file}`;
---

<figure class="m-0 w-fit max-w-full border-0 bg-transparent p-0">
  <img
    src={src}
    alt={alt}
    data-i18n-alt={altKey}
    width="1200"
    height="800"
    loading="lazy"
    class="block h-auto max-w-full object-contain"
    style="max-width: 5cm; height: auto; object-fit: contain"
  />
</figure>
