---
interface Props {
  file: string;
  altKey: string;
  alt: string;
}

const { file, altKey, alt } = Astro.props;
const src = `${import.meta.env.BASE_URL}images/stock/${file}`;
---

<figure class="overflow-hidden rounded-[1.2rem] border border-aluminum bg-muted" style="max-width: 5cm">
  <img
    src={src}
    alt={alt}
    data-i18n-alt={altKey}
    width="1200"
    height="800"
    loading="lazy"
    style="max-width: 5cm; height: auto"
    class="block w-full"
  />
</figure>
