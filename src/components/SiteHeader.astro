---
import LanguageSwitcher from "./LanguageSwitcher.tsx";
import ThemeToggle from "./ThemeToggle.tsx";

const links = [
  { href: "#fonctionnement", label: "Comment ça fonctionne", key: "nav.how" },
  { href: "#reparation", label: "Comment ça se répare", key: "nav.repair" },
  { href: "#cartes", label: "Cartes électroniques", key: "nav.boards" },
  { href: "#paiement", label: "Paiement", key: "nav.payment" },
  { href: "#contact", label: "WhatsApp", key: "nav.whatsapp" },
];
---

<header class="w-full border-b border-aluminum bg-background/90 backdrop-blur-md">
  <div
    class="flex w-full flex-nowrap items-center gap-2 py-2 lg:gap-3 lg:py-3"
    style="padding-inline: 1cm"
  >
    <a href="#accueil" class="flex shrink-0 items-center gap-2 text-foreground lg:gap-3">
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-2xl bg-primary text-sm font-semibold text-primary-foreground shadow-sm ring-1 ring-aluminum lg:h-10 lg:w-10"
        aria-hidden="true"
      >
        M
      </span>
      <span class="leading-tight">
        <span class="block font-display text-base font-semibold tracking-tight whitespace-nowrap lg:text-lg">MotorFix</span>
        <span class="hidden text-xs whitespace-nowrap text-muted-foreground xl:block" data-i18n="brand.tagline">Moteurs électriques</span>
      </span>
    </a>

    <nav
      id="navigation"
      aria-label="Navigation"
      class="hidden min-w-0 flex-1 flex-nowrap items-center gap-0.5 overflow-x-auto lg:flex lg:gap-1"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            data-i18n={link.key}
            class="shrink-0 rounded-full px-2 py-1.5 text-[13px] font-medium whitespace-nowrap text-foreground/80 transition hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none lg:px-2.5 lg:text-sm dark:text-[#E0C48A] dark:hover:text-[#E0C48A]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ms-auto hidden shrink-0 flex-nowrap items-center gap-1.5 lg:flex">
      <LanguageSwitcher client:load />
      <ThemeToggle client:load />
    </div>

    <button
      type="button"
      class="ms-auto inline-flex shrink-0 items-center justify-center rounded-full border border-border bg-background p-2 text-foreground lg:hidden"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="navigation-mobile"
    >
      <span class="sr-only" data-i18n="nav.menu">Menu</span>
      <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="navigation-mobile" class="hidden border-t border-aluminum py-3 lg:hidden" data-nav-panel style="padding-inline: 1cm">
    <ul class="grid gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-i18n={link.key}
              class="block rounded-2xl px-3 py-2 text-sm font-medium whitespace-nowrap text-foreground hover:bg-muted dark:text-[#E0C48A]"
              data-nav-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-3 flex flex-nowrap items-center gap-2">
      <LanguageSwitcher client:load />
      <ThemeToggle client:load />
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const panel = document.querySelector("[data-nav-panel]");

  toggle?.addEventListener("click", () => {
    const open = panel?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });

  document.querySelectorAll("[data-nav-link]").forEach((link) => {
    link.addEventListener("click", () => {
      panel?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
