---
import LanguageSwitcher from "./LanguageSwitcher.tsx";
import ThemeToggle from "./ThemeToggle.tsx";
import { Button } from "./ui/button.tsx";

const links = [
  { href: "#accueil", label: "Accueil", key: "nav.home" },
  { href: "#moteurs", label: "Moteurs", key: "nav.motors" },
  { href: "#maintenance", label: "Maintenance", key: "nav.maintenance" },
  { href: "#paiement", label: "Paiement", key: "nav.payment" },
  { href: "#contact", label: "WhatsApp", key: "nav.whatsapp" },
];
---

<header class="border-b border-aluminum bg-background/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 sm:px-6">
    <a href="#accueil" class="group flex min-w-0 items-center gap-3 text-foreground">
      <span
        class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-primary text-sm font-semibold text-primary-foreground shadow-sm ring-1 ring-aluminum"
        aria-hidden="true"
      >
        M
      </span>
      <span class="leading-tight">
        <span class="block font-display text-lg font-semibold tracking-tight">MotorFix</span>
        <span class="hidden text-xs text-muted-foreground sm:block" data-i18n="brand.tagline">Moteurs électriques</span>
      </span>
    </a>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <LanguageSwitcher client:load />
      <ThemeToggle client:load />

      <nav id="navigation" class="hidden items-center gap-1 md:flex" data-nav>
        {
          links.map((link) => (
            <a
              href={link.href}
              data-i18n={link.key}
              class="rounded-full px-3 py-2 text-sm font-medium text-foreground/80 transition hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <Button
        type="button"
        variant="outline"
        size="sm"
        className="rounded-full md:hidden"
        data-nav-toggle
        data-i18n="nav.menu"
        aria-expanded="false"
        aria-controls="navigation"
      >
        Menu
      </Button>
    </div>
  </div>
  <nav id="navigation-mobile" class="hidden border-t border-aluminum px-4 py-3 md:hidden" data-nav-panel>
    <ul class="grid gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-i18n={link.key}
              class="block rounded-2xl px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
              data-nav-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const panel = document.querySelector("[data-nav-panel]");

  toggle?.addEventListener("click", () => {
    const open = panel?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });

  document.querySelectorAll("[data-nav-link]").forEach((link) => {
    link.addEventListener("click", () => {
      panel?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
