---
const motors = [
  {
    id: "menager",
    label: "Appareils ménagers",
    kicker: "Maison",
    text: "Lave-linge, sèche-linge, lave-vaisselle, aspirateur, VMC, pompe ou petit moteur d’atelier : envoyez des photos de la plaque et de la panne.",
    points: ["Plaque signalétique", "Bruit, blocage, échauffement", "Estimation avant déplacement"],
  },
  {
    id: "scooter",
    label: "Scooters électriques",
    kicker: "Deux-roues",
    text: "Moteur de traction d’un scooter électrique : perte de puissance, à-coups, bruit métallique ou connectique abîmée.",
    points: ["Moteur de traction", "Faisceau et connecteurs", "Photos du symptôme"],
  },
  {
    id: "trottinette",
    label: "Trottinettes",
    kicker: "Mobilité",
    text: "Trottinettes électriques : moteur-roue, surchauffe, coupure en charge ou jeu anormal dans la roue motrice.",
    points: ["Moteur-roue", "Surchauffe et coupures", "Vue du câblage"],
  },
  {
    id: "vehicule",
    label: "Véhicules électriques",
    kicker: "Véhicule",
    text: "Voitures et petits utilitaires électriques : moteurs de traction et moteurs auxiliaires. L’estimation part des photos, avant toute intervention.",
    points: ["Traction et auxiliaires", "Contexte de la panne", "Pas d’intervention à l’aveugle"],
  },
];
---

<section id="moteurs" class="scroll-mt-36">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-[0.16em] text-copper-dark uppercase">Familles de moteurs</p>
      <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        Choisissez le type de moteur
      </h2>
      <p class="mt-3 text-muted">
        Filtrez les catégories. Chaque fiche indique ce qu’il est utile de photographier pour une estimation.
      </p>
    </div>
    <p class="text-sm text-muted" data-motor-status aria-live="polite">Toutes les familles sont affichées.</p>
  </div>

  <div
    class="mt-6 flex gap-2 overflow-x-auto pb-1"
    role="toolbar"
    aria-label="Filtrer les types de moteurs"
    data-explorer
  >
    <button
      type="button"
      class="shrink-0 rounded-full border border-line bg-paper px-4 py-2 text-sm font-semibold text-ink transition hover:border-copper/50 aria-pressed:border-pine aria-pressed:bg-pine aria-pressed:text-cream"
      data-filter="all"
      aria-pressed="true"
    >
      Tous
    </button>
    {
      motors.map((motor) => (
        <button
          type="button"
          class="shrink-0 rounded-full border border-line bg-paper px-4 py-2 text-sm font-semibold text-ink transition hover:border-copper/50 aria-pressed:border-pine aria-pressed:bg-pine aria-pressed:text-cream"
          data-filter={motor.id}
          aria-pressed="false"
        >
          {motor.label}
        </button>
      ))
    }
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-2">
    {
      motors.map((motor) => (
        <article
          id={motor.id}
          data-motor={motor.id}
          data-label={motor.label}
          class="scroll-mt-36 rounded-[1.6rem] border border-line bg-paper p-6 shadow-[0_16px_40px_-28px_rgba(28,25,21,0.45)]"
        >
          <p class="text-xs font-semibold tracking-[0.14em] text-copper-dark uppercase">{motor.kicker}</p>
          <h3 class="mt-2 font-display text-2xl font-semibold">{motor.label}</h3>
          <p class="mt-3 text-sm leading-6 text-muted">{motor.text}</p>
          <ul class="mt-4 grid gap-2 text-sm">
            {motor.points.map((point) => (
              <li class="flex gap-2">
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-copper" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<script>
  const explorer = document.querySelector("[data-explorer]");
  const status = document.querySelector("[data-motor-status]");
  const buttons = [...document.querySelectorAll("[data-filter]")];
  const cards = [...document.querySelectorAll("[data-motor]")];

  const applyFilter = (id: string) => {
    buttons.forEach((button) => {
      const active = button.getAttribute("data-filter") === id;
      button.setAttribute("aria-pressed", active ? "true" : "false");
    });

    const visible = cards.filter((card) => {
      const show = id === "all" || card.getAttribute("data-motor") === id;
      card.toggleAttribute("hidden", !show);
      return show;
    });

    if (status) {
      if (id === "all") {
        status.textContent = "Toutes les familles sont affichées.";
      } else {
        const label = visible[0]?.getAttribute("data-label") ?? "cette famille";
        status.textContent = `${label} : fiche affichée.`;
      }
    }
  };

  explorer?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest("[data-filter]");
    if (!(button instanceof HTMLElement)) return;
    const id = button.getAttribute("data-filter");
    if (!id) return;
    applyFilter(id);
  });
</script>
